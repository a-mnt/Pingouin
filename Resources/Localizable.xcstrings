            "value" : "This name is not suitable: it must not be empty or contain “/”, quotation marks, “*”, “?”, “[” or “\\”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este nombre no es válido: no debe estar vacío ni contener «/», comillas, «*», «?», «[» o «\\»."

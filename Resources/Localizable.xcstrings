    "Les connexions du Mac ne sont pas reprises : chaque appareil garde les siennes, et ses secrets dans son Trousseau." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac's connections are not carried over: each device keeps its own, and its secrets in its own Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conexiones del Mac no se trasladan: cada dispositivo guarda las suyas, y sus secretos en su propio Llavero."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindungen des Mac werden nicht übernommen: Jedes Gerät behält seine eigenen, und seine Geheimnisse im eigenen Schlüsselbund."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le connessioni del Mac non vengono riprese: ogni dispositivo conserva le proprie, e i propri segreti nel suo Portachiavi."
          }
        }
      }

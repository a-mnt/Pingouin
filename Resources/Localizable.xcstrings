    "Délai : de 100 à 10 000 ms, attendu sur chaque port qui ne répond pas. Connexions : de 1 à 128 ; trop rapprochées, certains équipements les ignorent." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout: 100 to 10,000 ms, waited on every port that does not answer. Connections: 1 to 128; when too close together, some devices ignore them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo de espera: de 100 a 10 000 ms, en cada puerto que no responde. Conexiones: de 1 a 128; demasiado seguidas, algunos equipos las ignoran."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitlimit: 100 bis 10.000 ms, gewartet bei jedem Port, der nicht antwortet. Verbindungen: 1 bis 128; folgen sie zu dicht aufeinander, ignorieren manche Geräte sie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout: da 100 a 10.000 ms, atteso su ogni porta che non risponde. Connessioni: da 1 a 128; se troppo ravvicinate, alcuni apparati le ignorano."
          }
        }
      }
    },

    "Fermé : l'hôte a refusé la connexion. Indéterminé : aucune réponse avant le délai, ce qui arrive souvent derrière un pare-feu." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closed: the host refused the connection. Undetermined: no answer before the timeout, which often happens behind a firewall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrado: el host rechazó la conexión. Indeterminado: ninguna respuesta antes del tiempo de espera, algo frecuente detrás de un cortafuegos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschlossen: Der Host hat die Verbindung abgelehnt. Unbestimmt: keine Antwort vor Ablauf des Zeitlimits, was hinter einer Firewall häufig vorkommt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiusa: l'host ha rifiutato la connessione. Indeterminata: nessuna risposta prima del timeout, cosa frequente dietro un firewall."
          }
        }
      }
    },

    "« %@ » n'est ni un port ni une plage. Séparer les ports par des virgules et écrire les plages sous la forme 8000-8100." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is neither a port nor a range. Separate ports with commas and write ranges as 8000-8100."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no es ni un puerto ni un rango. Separa los puertos con comas y escribe los rangos con la forma 8000-8100."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist weder ein Port noch ein Bereich. Ports durch Kommas trennen und Bereiche in der Form 8000-8100 schreiben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» non è né una porta né un intervallo. Separa le porte con virgole e scrivi gli intervalli nella forma 8000-8100."
          }
        }
      }
    },

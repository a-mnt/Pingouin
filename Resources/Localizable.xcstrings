    "L'ancienne clé est détruite et ne peut pas être retrouvée. Les serveurs qui la connaissent refuseront la connexion tant que la nouvelle clé publique n'y aura pas été déposée." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old key is destroyed and cannot be recovered. Servers that know it will refuse the connection until the new public key has been installed on them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave antigua se destruye y no se puede recuperar. Los servidores que la conocen rechazarán la conexión hasta que se haya instalado en ellos la nueva clave pública."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der alte Schlüssel wird vernichtet und kann nicht wiederhergestellt werden. Server, die ihn kennen, lehnen die Verbindung ab, bis der neue öffentliche Schlüssel dort hinterlegt wurde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vecchia chiave viene distrutta e non può essere recuperata. I server che la conoscono rifiuteranno la connessione finché la nuova chiave pubblica non vi sarà stata installata."
          }
        }
      }
    },

    "La langue s'applique au lancement. Redémarrer met fin aux sessions SSH ouvertes, aux transferts de fichiers et aux opérations en cours ; les données enregistrées sont conservées." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The language is applied at launch. Restarting ends open SSH sessions, file transfers and running operations; saved data is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma se aplica al abrir la aplicación. Reiniciar finaliza las sesiones SSH abiertas, las transferencias de archivos y las operaciones en curso; los datos guardados se conservan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprache wird beim Start übernommen. Ein Neustart beendet offene SSH-Sitzungen, Dateiübertragungen und laufende Vorgänge; gesicherte Daten bleiben erhalten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lingua viene applicata all'avvio. Il riavvio termina le sessioni SSH aperte, i trasferimenti di file e le operazioni in corso; i dati salvati vengono conservati."
          }
        }
      }

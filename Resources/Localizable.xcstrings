    "URL non valide. Attendu : une adresse en http:// ou https://, par exemple https://example.com/." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invalid URL. Expected: an address starting with http:// or https://, for example https://example.com/."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL no válida. Se espera una dirección en http:// o https://, por ejemplo https://example.com/."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

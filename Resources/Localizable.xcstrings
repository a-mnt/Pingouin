    "« %@ » contient un caractère que Pingouin ne sait pas transmettre à sftp (guillemet, « * », « ? », « [ » ou « \\ »). Aucune action n'a été lancée." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” contains a character that Pingouin cannot pass to sftp (quotation mark, “*”, “?”, “[” or “\\”). No action was started."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» contiene un carácter que Pingouin no sabe transmitir a sftp (comillas, «*», «?», «[» o «\\»). No se ha lanzado ninguna acción."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ enthält ein Zeichen, das Pingouin nicht an sftp übergeben kann (Anführungszeichen, „*“, „?“, „[“ oder „\\“). Es wurde keine Aktion gestartet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» contiene un carattere che Pingouin non sa trasmettere a sftp (virgolette, «*», «?», «[» o «\\»). Non è stata avviata alcuna azione."
          }
        }
      }
    },

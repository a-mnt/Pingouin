    "De 1 à 128. Une valeur élevée accélère le scan, mais certains équipements ignorent les connexions trop rapprochées." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From 1 to 128. A high value speeds up the scan, but some devices ignore connections that come too close together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 1 a 128. Un valor alto acelera el escaneo, pero algunos equipos ignoran las conexiones demasiado seguidas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von 1 bis 128. Ein hoher Wert beschleunigt den Scan, aber manche Geräte ignorieren zu dicht aufeinanderfolgende Verbindungen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da 1 a 128. Un valore alto accelera la scansione, ma alcuni apparati ignorano le connessioni troppo ravvicinate."
          }
        }
      }
    },

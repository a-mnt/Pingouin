          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La box está conectada pero no ha proporcionado ninguna lectura. El mensaje de arriba indica el motivo; «Copiar el diagnóstico» reúne sus respuestas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Box ist verbunden, hat aber keine Ablesung geliefert. Die Meldung oben nennt den Grund; „Diagnose kopieren“ fasst ihre Antworten zusammen."
          }
        },
        "it" : {
